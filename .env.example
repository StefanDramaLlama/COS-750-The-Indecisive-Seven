# Local SQLite. Relative paths are resolved from the repository root.
SQLITE_PATH=.data/graphwise.sqlite
# Set both values for a hosted Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional server-side study helper. Use .env or .env.local locally.
GOOGLE_AI_STUDIO_API_KEY=
